# LinuxCNC infrastructure modules — C milltask variant.
# Use this instead of linuxcnc.hal when testing with cmod/milltask.so.
# Loads emcgateway to bridge C milltask NML stat/cmd to GMI websocket API.

load tpmod
load homemod
load io <iocontrol>
load halui
load milltask
load emcgateway

# load UI helper
load ngcpreview
load halscope
