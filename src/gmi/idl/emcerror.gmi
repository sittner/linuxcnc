# EMC Error Channel API
# Error/info message stream — replaces linuxcnc.error_channel() for UI clients.
# Gateway module (emcgateway) polls NML error buffer and pushes via WebSocket.

@api emcerror
@version 1
@prefix emcerror
@rest_export true

# ─── Enums ───

# Error/message kind (linuxcnc.NML_ERROR, OPERATOR_ERROR, etc.)
enum ErrorKind {
    NML_ERROR = 1
    NML_TEXT = 2
    NML_DISPLAY = 3
    OPERATOR_ERROR = 11
    OPERATOR_TEXT = 12
    OPERATOR_DISPLAY = 13
}

# ─── Types ───

type ErrorMessage {
    kind: ErrorKind
    text: string
}

# ─── Functions ───

# Poll for new error/info messages, pushed via WebSocket at 200ms intervals.
# Returns only messages that arrived since the last poll (gateway tracks position).
@watch true
@watch_default_rate 200ms
@method "GET"
@path "/errors"
func get_errors() -> []ErrorMessage
