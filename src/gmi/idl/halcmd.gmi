# HAL Command API
# Commands exposed by launcher for HAL manipulation via REST

@api halcmd
@version 1
@prefix halcmd
@rest_export true

# ─── Types ───

type CmdResult {
    success: bool
    output: string?
    error: string?
}

type PinInfo {
    name: string
    type: string
    dir: string
    value: string
    owner: string
}

type SignalInfo {
    name: string
    type: string
    value: string
    writers: []string
    readers: []string
}

type ComponentInfo {
    name: string
    id: i32
    type: string
    state: string
    pid: i32?
}

# ─── Query Commands ───

@method "GET"
@path "/pins"
@rt_safe "false"
func list_pins(pattern: string?) -> []PinInfo

@method "GET"
@path "/signals"
@rt_safe "false"
func list_signals(pattern: string?) -> []SignalInfo

@method "GET"
@path "/components"
@rt_safe "false"
func list_components(pattern: string?) -> []ComponentInfo

@method "GET"
@path "/pin/{name}"
@rt_safe "false"
func get_pin(name: string) -> PinInfo

@method "GET"
@path "/signal/{name}"
@rt_safe "false"
func get_signal(name: string) -> SignalInfo

# ─── Mutation Commands ───

@method "PUT"
@path "/pin/{name}"
@rt_safe "false"
func set_pin(name: string, value: string) -> CmdResult

@method "PUT"
@path "/signal/{name}"
@rt_safe "false"
func set_signal(name: string, value: string) -> CmdResult

@method "POST"
@path "/signal"
@rt_safe "false"
func new_signal(name: string, type: string) -> CmdResult

@method "DELETE"
@path "/signal/{name}"
@rt_safe "false"
func delete_signal(name: string) -> CmdResult

@method "POST"
@path "/link"
@rt_safe "false"
func link(pin: string, signal: string) -> CmdResult

@method "DELETE"
@path "/link/{pin}"
@rt_safe "false"
func unlink(pin: string) -> CmdResult

# ─── Module Commands ───

@method "POST"
@path "/load"
@rt_safe "false"
func load(module: string, args: []string?) -> CmdResult

@method "DELETE"
@path "/module/{module}"
@rt_safe "false"
func unload(module: string) -> CmdResult

# ─── Thread Commands ───

@method "POST"
@path "/thread"
@rt_safe "false"
func add_thread(name: string, period_ns: i64, fp: bool?) -> CmdResult

@method "POST"
@path "/thread/{thread}/function"
@rt_safe "false"
func add_function(thread: string, function: string, position: i32?) -> CmdResult

@method "POST"
@path "/start"
@rt_safe "false"
func start() -> CmdResult

@method "POST"
@path "/stop"
@rt_safe "false"
func stop() -> CmdResult
