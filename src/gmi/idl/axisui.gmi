# Axis UI API
# WebSocket watch interface for the AXIS GUI.
# Replaces the axisui HAL component Python bindings with a cmod + WebSocket client.
#
# Data flows:
#   HAL → UI:  watch functions push input pin states to axis.py
#   UI → HAL:  command functions set output pin values from axis.py

@api axisui
@version 1
@prefix axisui
@rest_export true

# --- Types ---

# Per-axis jog button states (input from HAL — physical buttons / pendants)
type JogInputs {
    disable: bool
    x_plus: bool
    x_minus: bool
    y_plus: bool
    y_minus: bool
    z_plus: bool
    z_minus: bool
    a_plus: bool
    a_minus: bool
    b_plus: bool
    b_minus: bool
    c_plus: bool
    c_minus: bool
    u_plus: bool
    u_minus: bool
    v_plus: bool
    v_minus: bool
    w_plus: bool
    w_minus: bool
}

# Slider encoder inputs from HAL (e.g. MPG / override knobs)
type SliderInputs {
    scale: f64
    scale_abs: f64
    feedoverride: i32
    feedoverride_abs: i32
    rapidoverride: i32
    rapidoverride_abs: i32
    spinoverride: i32
    spinoverride_abs: i32
    jogspeed: i32
    jogspeed_abs: i32
    ajogspeed: i32
    ajogspeed_abs: i32
    maxvel: i32
    maxvel_abs: i32
}

# Notification control inputs from HAL
type NotificationInputs {
    notifications_clear: bool
    notifications_clear_info: bool
    notifications_clear_error: bool
    resume_inhibit: bool
}

# --- Watch functions (HAL → UI) ---

@watch true
@watch_default_rate 20ms
@method "GET"
@path "/jog-inputs"
func get_jog_inputs() -> JogInputs

@watch true
@watch_default_rate 50ms
@method "GET"
@path "/slider-inputs"
func get_slider_inputs() -> SliderInputs

@watch true
@watch_default_rate 200ms
@method "GET"
@path "/notification-inputs"
func get_notification_inputs() -> NotificationInputs

# --- Command functions (UI → HAL) ---

# Set which axis is selected for jogging (letter: x, y, z, a, b, c, u, v, w)
@method "POST"
@path "/set-jog-axis"
func set_jog_axis(axis: string) -> bool

# Set the jog increment distance (0.0 = continuous)
@method "POST"
@path "/set-jog-increment"
func set_jog_increment(increment: f64) -> bool

# Signal that the UI is alive
@method "POST"
@path "/set-is-running"
func set_is_running(running: bool) -> bool

# Set the has-notifications output pin
@method "POST"
@path "/set-has-notifications"
func set_has_notifications(has: bool) -> bool

# Set the error output pin
@method "POST"
@path "/set-error"
func set_error(error: bool) -> bool

# Set the abort output pin
@method "POST"
@path "/set-abort"
func set_abort(abort: bool) -> bool
