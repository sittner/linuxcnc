# GMI - Generated Message Interface Runtime Library
# SPDX-License-Identifier: GPL-2.0-or-later
#
# This library provides common utilities for GMI-generated code:
# - Error handling (gmi_error)
# - Dynamic buffers (gmi_types)
# - JSON parsing/building (gmi_json, wraps cJSON)
# - HTTP client (gmi_http, wraps libcurl)
#
# Dependencies:
# - libcurl: sudo apt install libcurl4-openssl-dev
# - cJSON: Either install libcjson-dev OR download cJSON.c from
#   https://github.com/DaveGamble/cJSON (MIT license, 2 files)

# Include path
INCLUDES += gmi

# Public headers -> ../include/
../include/gmi.h: gmi/gmi.h
	cp $< $@
../include/gmi_error.h: gmi/gmi_error.h
	cp $< $@
../include/gmi_types.h: gmi/gmi_types.h
	cp $< $@
../include/gmi_json.h: gmi/gmi_json.h
	cp $< $@
../include/gmi_http.h: gmi/gmi_http.h
	cp $< $@
../include/cJSON.h: gmi/cJSON.h
	cp $< $@

GMI_HEADERS := ../include/gmi.h ../include/gmi_error.h ../include/gmi_types.h \
               ../include/gmi_json.h ../include/gmi_http.h ../include/cJSON.h

# Source files
GMI_SRCS := gmi/gmi_error.c gmi/gmi_types.c gmi/gmi_json.c gmi/gmi_http.c

# Check for system cJSON or use embedded
ifneq ($(wildcard gmi/cJSON.c),)
GMI_SRCS += gmi/cJSON.c
GMI_CJSON_FLAGS :=
else
# Use system libcjson
GMI_CJSON_FLAGS := $(shell pkg-config --cflags --libs libcjson 2>/dev/null)
ifeq ($(GMI_CJSON_FLAGS),)
$(warning cJSON not found. Either install libcjson-dev or download cJSON.c to src/gmi/)
endif
endif

# Compile flags for shared library
$(call TOOBJSDEPS, $(GMI_SRCS)): EXTRAFLAGS = -fPIC $(shell pkg-config --cflags libcurl 2>/dev/null)

USERSRCS += $(GMI_SRCS)

# Targets
TARGETS += ../lib/libgmi.so ../lib/libgmi.so.0

# Build rule
../lib/libgmi.so.0: $(call TOOBJS, $(GMI_SRCS)) $(GMI_HEADERS)
	$(ECHO) Creating shared library $(notdir $@)
	@mkdir -p ../lib
	@rm -f $@
	$(Q)$(CC) $(LDFLAGS) -Wl,-soname,$(notdir $@) -shared -o $@ $(call TOOBJS, $(GMI_SRCS)) \
		$(shell pkg-config --libs libcurl 2>/dev/null || echo -lcurl) \
		$(GMI_CJSON_FLAGS)
