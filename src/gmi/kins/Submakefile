# ---------------------------------------------------------------------------
# GMI kinematics modules
# ---------------------------------------------------------------------------
# Kinematics modules using the GMI dynamic API infrastructure.
# These are cmod .so plugins that register callbacks through
# env->api->register_api (no link-time dependency on the Go launcher).
#
# Generated header (kins_api.h) lives in launcher/generated/gmi/kins/.
# ---------------------------------------------------------------------------

ifeq ($(BUILD_GOLANG),yes)

GMI_KINS_INCLUDE := launcher/pkg/cmodule
GMI_KINS_API_INCLUDE := launcher/generated/gmi/kins
GMI_KINS_COMMON := gmi/kins

GMI_KINS_CFLAGS = -fPIC -Os -Wall -Wextra -shared \
    -I $(GMI_KINS_INCLUDE) \
    -I $(GMI_KINS_API_INCLUDE) \
    -I $(GMI_KINS_COMMON)

GMI_KINS_DEPS = $(wildcard launcher/generated/gmi/kins/kins_api.h) \
                $(wildcard launcher/pkg/cmodule/gomc_env.h)

# Helper: build a simple kins cmod .so from a single .c file
# $(1) = module name  $(2) = source dir relative to src/
define GMI_KINS_BUILD
../cmod/$(1).so: $(2)/$(1).c $$(GMI_KINS_DEPS)
	$$(ECHO) "Compiling GMI cmod $$(notdir $$@)"
	@mkdir -p $$(dir $$@)
	$$(Q)$$(CC) $$(GMI_KINS_CFLAGS) -o $$@ $$< -lm
TARGETS += ../cmod/$(1).so
modules: ../cmod/$(1).so
endef

# --- Group 0: trivkins (already ported) ---
$(eval $(call GMI_KINS_BUILD,trivkins,gmi/kins/trivkins))

# --- Group A: simple non-switchable (no HAL pins) ---
$(eval $(call GMI_KINS_BUILD,corexykins,gmi/kins/corexykins))
$(eval $(call GMI_KINS_BUILD,rotatekins,gmi/kins/rotatekins))
$(eval $(call GMI_KINS_BUILD,scorbot-kins,gmi/kins/scorbot-kins))

# --- Group B: non-switchable with HAL pins ---
$(eval $(call GMI_KINS_BUILD,lineardeltakins,gmi/kins/lineardeltakins))
$(eval $(call GMI_KINS_BUILD,rotarydeltakins,gmi/kins/rotarydeltakins))
$(eval $(call GMI_KINS_BUILD,maxkins,gmi/kins/maxkins))
$(eval $(call GMI_KINS_BUILD,rosekins,gmi/kins/rosekins))
$(eval $(call GMI_KINS_BUILD,tripodkins,gmi/kins/tripodkins))
$(eval $(call GMI_KINS_BUILD,pentakins,gmi/kins/pentakins))

# --- Group C: switchkins-based ---
$(eval $(call GMI_KINS_BUILD,5axiskins,gmi/kins/5axiskins))
$(eval $(call GMI_KINS_BUILD,xyzac-trt-kins,gmi/kins/xyzac-trt-kins))
$(eval $(call GMI_KINS_BUILD,xyzbc-trt-kins,gmi/kins/xyzbc-trt-kins))
$(eval $(call GMI_KINS_BUILD,scarakins,gmi/kins/scarakins))
$(eval $(call GMI_KINS_BUILD,pumakins,gmi/kins/pumakins))

# --- Group D: switchkins-based with posemath/gomath linkage ---
# These link against libposemath.so (already built with -fPIC).
GMI_POSEMATH_INCDIR := libnml/posemath

# Helper: build a kins cmod that links against libposemath.so
# $(1) = module name  $(2) = source dir relative to src/
define GMI_KINS_POSEMATH_BUILD
../cmod/$(1).so: $(2)/$(1).c ../lib/libposemath.so $$(GMI_KINS_DEPS)
	$$(ECHO) "Compiling GMI cmod $$(notdir $$@)"
	@mkdir -p $$(dir $$@)
	$$(Q)$$(CC) $$(GMI_KINS_CFLAGS) -I $$(GMI_POSEMATH_INCDIR) -I rtapi -o $$@ $$< -L../lib -lposemath -lm
TARGETS += ../cmod/$(1).so
modules: ../cmod/$(1).so
endef

$(eval $(call GMI_KINS_POSEMATH_BUILD,genhexkins,gmi/kins/genhexkins))
$(eval $(call GMI_KINS_POSEMATH_BUILD,genserkins,gmi/kins/genserkins))

endif # BUILD_GOLANG
