# ---------------------------------------------------------------------------
# GMI code generation
# ---------------------------------------------------------------------------
# Runs modcompile gmi on .gmi IDL files to produce C headers and Go cgo shims.
# Generated output goes to gomc/generated/gmi/<api>/ so it is:
#   - Inside the Go module (importable)
#   - Separate from hand-written code
#   - Gitignored (not checked in)
#
# This Submakefile must appear in SUBDIRS after 'gomc' (which builds
# modcompile) and before any Submakefile that uses the generated headers
# (e.g. gmi/kins).
# ---------------------------------------------------------------------------

ifeq ($(BUILD_GOLANG),yes)

GMICOMPILE := ../bin/modcompile gmi
GMICOMPILE_BIN := ../bin/modcompile

# IDL source files
GMI_KINS_IDL := gmi/idl/kins.gmi

# Generated output directory (relative to src/)
GMI_KINS_GEN := gomc/generated/gmi/kins

# --- kins API ---
# gmicompile --server-c produces both the .h and _cgo.go in one invocation.
# Only the .h carries the recipe; the .go is a side-effect that depends on
# the .h so Make knows it exists once the recipe has run.

$(GMI_KINS_GEN)/kins_api.h: $(GMI_KINS_IDL) $(GMICOMPILE_BIN)
	$(ECHO) "Generating GMI kins API from $(GMI_KINS_IDL)"
	@mkdir -p $(GMI_KINS_GEN)
	$(Q)$(GMICOMPILE) --server-c $(GMI_KINS_IDL) -o $(GMI_KINS_GEN)/kins_api.h
	$(Q)$(GMICOMPILE_BIN) add-gmi generated/gmi/kins

$(GMI_KINS_GEN)/kins_cgo.go: $(GMI_KINS_GEN)/kins_api.h

# Make generated files available as prerequisites for downstream Submakefiles
TARGETS += $(GMI_KINS_GEN)/kins_api.h

# --- tp API ---

GMI_TP_IDL := gmi/idl/tp.gmi
GMI_TP_GEN := gomc/generated/gmi/tp

$(GMI_TP_GEN)/tp_api.h: $(GMI_TP_IDL) $(GMICOMPILE_BIN)
	$(ECHO) "Generating GMI tp API from $(GMI_TP_IDL)"
	@mkdir -p $(GMI_TP_GEN)
	$(Q)$(GMICOMPILE) --server-c $(GMI_TP_IDL) -o $(GMI_TP_GEN)/tp_api.h
	$(Q)$(GMICOMPILE_BIN) add-gmi generated/gmi/tp

$(GMI_TP_GEN)/tp_cgo.go: $(GMI_TP_GEN)/tp_api.h

TARGETS += $(GMI_TP_GEN)/tp_api.h

# --- home API ---

GMI_HOME_IDL := gmi/idl/home.gmi
GMI_HOME_GEN := gomc/generated/gmi/home

$(GMI_HOME_GEN)/home_api.h: $(GMI_HOME_IDL) $(GMICOMPILE_BIN)
	$(ECHO) "Generating GMI home API from $(GMI_HOME_IDL)"
	@mkdir -p $(GMI_HOME_GEN)
	$(Q)$(GMICOMPILE) --server-c $(GMI_HOME_IDL) -o $(GMI_HOME_GEN)/home_api.h
	$(Q)$(GMICOMPILE_BIN) add-gmi generated/gmi/home

$(GMI_HOME_GEN)/home_cgo.go: $(GMI_HOME_GEN)/home_api.h

TARGETS += $(GMI_HOME_GEN)/home_api.h

# --- mot API (reverse callbacks: motmod → tpmod/homemod) ---

GMI_MOT_IDL := gmi/idl/mot.gmi
GMI_MOT_GEN := gomc/generated/gmi/mot

$(GMI_MOT_GEN)/mot_api.h: $(GMI_MOT_IDL) $(GMICOMPILE_BIN)
	$(ECHO) "Generating GMI mot API from $(GMI_MOT_IDL)"
	@mkdir -p $(GMI_MOT_GEN)
	$(Q)$(GMICOMPILE) --server-c $(GMI_MOT_IDL) -o $(GMI_MOT_GEN)/mot_api.h
	$(Q)$(GMICOMPILE_BIN) add-gmi generated/gmi/mot

$(GMI_MOT_GEN)/mot_cgo.go: $(GMI_MOT_GEN)/mot_api.h

TARGETS += $(GMI_MOT_GEN)/mot_api.h

# --- manualtoolchange API ---

GMI_MTC_IDL := gmi/idl/manualtoolchange.gmi
GMI_MTC_GEN := gomc/generated/gmi/manualtoolchange

$(GMI_MTC_GEN)/manualtoolchange_api.h: $(GMI_MTC_IDL) $(GMICOMPILE_BIN)
	$(ECHO) "Generating GMI manualtoolchange API from $(GMI_MTC_IDL)"
	@mkdir -p $(GMI_MTC_GEN)
	$(Q)$(GMICOMPILE) --server-c $(GMI_MTC_IDL) -o $(GMI_MTC_GEN)/manualtoolchange_api.h
	$(Q)$(GMICOMPILE_BIN) add-gmi generated/gmi/manualtoolchange

$(GMI_MTC_GEN)/manualtoolchange_cgo.go: $(GMI_MTC_GEN)/manualtoolchange_api.h

TARGETS += $(GMI_MTC_GEN)/manualtoolchange_api.h

# --- manualtoolchange Python REST client ---

GMI_MTC_PY := ../lib/python/gmi/manualtoolchange_client.py

$(GMI_MTC_PY): $(GMI_MTC_IDL) $(GMICOMPILE_BIN)
	$(ECHO) "Generating GMI manualtoolchange Python client from $(GMI_MTC_IDL)"
	@mkdir -p $(dir $(GMI_MTC_PY))
	@touch $(dir $(GMI_MTC_PY))__init__.py
	$(Q)$(GMICOMPILE) --client-python $(GMI_MTC_IDL) -o $(GMI_MTC_PY)

TARGETS += $(GMI_MTC_PY)

# --- axisui API (watch-enabled: server-c + server-ws + client-python-ws) ---

GMI_AXISUI_IDL := gmi/idl/axisui.gmi
GMI_AXISUI_GEN := gomc/generated/gmi/axisui

$(GMI_AXISUI_GEN)/axisui_api.h: $(GMI_AXISUI_IDL) $(GMICOMPILE_BIN)
	$(ECHO) "Generating GMI axisui API from $(GMI_AXISUI_IDL)"
	@mkdir -p $(GMI_AXISUI_GEN)
	$(Q)$(GMICOMPILE) --server-c $(GMI_AXISUI_IDL) -o $(GMI_AXISUI_GEN)/axisui_api.h
	$(Q)$(GMICOMPILE_BIN) add-gmi generated/gmi/axisui

$(GMI_AXISUI_GEN)/axisui_cgo.go: $(GMI_AXISUI_GEN)/axisui_api.h

$(GMI_AXISUI_GEN)/axisui_ws.go: $(GMI_AXISUI_IDL) $(GMI_AXISUI_GEN)/axisui_cgo.go $(GMICOMPILE_BIN)
	$(ECHO) "Generating GMI axisui WebSocket server from $(GMI_AXISUI_IDL)"
	$(Q)$(GMICOMPILE) --server-ws $(GMI_AXISUI_IDL) -o $(GMI_AXISUI_GEN)/axisui_ws.go

TARGETS += $(GMI_AXISUI_GEN)/axisui_api.h $(GMI_AXISUI_GEN)/axisui_ws.go

GMI_AXISUI_PY_WS := ../lib/python/gmi/axisui_ws_client.py

$(GMI_AXISUI_PY_WS): $(GMI_AXISUI_IDL) $(GMICOMPILE_BIN)
	$(ECHO) "Generating GMI axisui Python WebSocket client from $(GMI_AXISUI_IDL)"
	@mkdir -p $(dir $(GMI_AXISUI_PY_WS))
	@touch $(dir $(GMI_AXISUI_PY_WS))__init__.py
	$(Q)$(GMICOMPILE) --client-python-ws $(GMI_AXISUI_IDL) -o $(GMI_AXISUI_PY_WS)

TARGETS += $(GMI_AXISUI_PY_WS)

clean: gmi-codegen-clean
.PHONY: gmi-codegen-clean
gmi-codegen-clean:
	rm -rf gomc/generated/

endif # BUILD_GOLANG
