# ---------------------------------------------------------------------------
# GMI code generation
# ---------------------------------------------------------------------------
# Runs modcompile gmi on .gmi IDL files to produce C headers and Go cgo shims.
# Generated output goes to gomc/generated/gmi/<api>/ so it is:
#   - Inside the Go module (importable)
#   - Separate from hand-written code
#   - Gitignored (not checked in)
#
# This Submakefile must appear in SUBDIRS after 'gomc' (which builds
# modcompile) and before any Submakefile that uses the generated headers
# (e.g. gmi/kins).
# ---------------------------------------------------------------------------

ifeq ($(BUILD_GOLANG),yes)

GMICOMPILE := ../bin/modcompile gmi
GMICOMPILE_BIN := ../bin/modcompile

# IDL source files
GMI_KINS_IDL := gmi/idl/kins.gmi

# Generated output directory (relative to src/)
GMI_KINS_GEN := gomc/generated/gmi/kins

# --- kins API ---
# gmicompile --server-c produces both the .h and _cgo.go in one invocation.
# Only the .h carries the recipe; the .go is a side-effect that depends on
# the .h so Make knows it exists once the recipe has run.

$(GMI_KINS_GEN)/kins_api.h: $(GMI_KINS_IDL) $(GMICOMPILE_BIN)
	$(ECHO) "Generating GMI kins API from $(GMI_KINS_IDL)"
	@mkdir -p $(GMI_KINS_GEN)
	$(Q)$(GMICOMPILE) --server-c $(GMI_KINS_IDL) -o $(GMI_KINS_GEN)/kins_api.h
	$(Q)$(GMICOMPILE_BIN) add-gmi generated/gmi/kins

$(GMI_KINS_GEN)/kins_cgo.go: $(GMI_KINS_GEN)/kins_api.h

# Make generated files available as prerequisites for downstream Submakefiles
TARGETS += $(GMI_KINS_GEN)/kins_api.h

