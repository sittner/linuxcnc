EMCSHSRCS := emc/usr_intf/emcsh.cc \
             emc/usr_intf/shcom.cc
EMCLCDSRCS := emc/usr_intf/emclcd.cc \
              emc/usr_intf/shcom.cc \
              emc/usr_intf/sockets.c

USERSRCS += $(EMCSHSRCS) $(EMCLCDSRCS) $(USRMOTSRCS)

$(call TOOBJSDEPS, $(EMCSHSRCS)) : EXTRAFLAGS = $(ULFLAGS) $(TCL_CFLAGS) -fPIC

../tcl/linuxcnc.so: $(call TOOBJS, $(EMCSHSRCS)) ../lib/liblinuxcnc.a ../lib/liblinuxcncini.so.0
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CXX) -shared $(LDFLAGS) -o $@ $(ULFLAGS) $(TCL_CFLAGS) $^ $(TCL_LIBS) -lXinerama
TARGETS += ../tcl/linuxcnc.so

../bin/linuxcnclcd: $(call TOOBJS, $(EMCLCDSRCS)) ../lib/liblinuxcnchal.so.0 ../lib/liblinuxcnc.a ../lib/libnml.so.0 ../lib/liblinuxcncini.so.0
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CXX) -o $@ $(ULFLAGS) $^ $(LDFLAGS)
TARGETS += ../bin/linuxcnclcd

# halui.so — cmod plugin variant (uses gomc API, no liblinuxcnchal)
HALUI_GOMC_SRCS := emc/usr_intf/halui_gomc.cc

USERSRCS += $(HALUI_GOMC_SRCS)

$(call TOOBJSDEPS, $(HALUI_GOMC_SRCS)): EXTRAFLAGS += -fPIC -Igomc/generated/gmi/emccmd -Igomc/generated/gmi/emcstat -Igomc/pkg/cmodule
$(call TOOBJSDEPS, $(HALUI_GOMC_SRCS)): gomc/generated/gmi/emccmd/emccmd_api.h gomc/generated/gmi/emcstat/emcstat_api.h

../cmod/halui.so: $(call TOOBJS, $(HALUI_GOMC_SRCS)) \
                  ../lib/liblinuxcnc.a ../lib/liblinuxcncini.so.0 \
                  ../lib/libtooldata.so.0
	$(ECHO) Linking $(notdir $@)
	@mkdir -p ../cmod
	@$(CXX) -shared -o $@ $^ $(LDFLAGS)
TARGETS += ../cmod/halui.so
