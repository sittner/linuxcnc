USERSRCS += $(USRMOTSRCS)

# halui.so — cmod plugin variant (uses gomc API, no liblinuxcnchal)
HALUI_GOMC_SRCS := emc/usr_intf/halui_gomc.cc

USERSRCS += $(HALUI_GOMC_SRCS)

$(call TOOBJSDEPS, $(HALUI_GOMC_SRCS)): EXTRAFLAGS += -fPIC -Igomc/generated/gmi/emccmd -Igomc/generated/gmi/emcstat -Igomc/pkg/cmodule
$(call TOOBJSDEPS, $(HALUI_GOMC_SRCS)): gomc/generated/gmi/emccmd/emccmd_api.h gomc/generated/gmi/emcstat/emcstat_api.h

../cmod/halui.so: $(call TOOBJS, $(HALUI_GOMC_SRCS)) \
                  ../lib/liblinuxcnc.a ../lib/liblinuxcncini.so.0 \
                  ../lib/libtooldata.so.0
	$(ECHO) Linking $(notdir $@)
	@mkdir -p ../cmod
	@$(CXX) -shared -o $@ $^ $(LDFLAGS)
TARGETS += ../cmod/halui.so
