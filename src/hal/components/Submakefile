    conv_u32_float.comp conv_u32_bit.comp conv_u32_s32.comp

# ---------------------------------------------------------------------------
# Components built via modcompile (cmod API, output to ../cmod/)
# ---------------------------------------------------------------------------
CMOD_COMP_NAMES := \
    abs abs_s32 and2 axistest bin2gray bitslice bitwise blend \
    charge_pump clarke2 clarke3 clarkeinv comp constant \
    conv_bit_float conv_bit_s32 conv_bit_u32 \
    conv_float_s32 conv_float_u32 \
    conv_s32_bit conv_s32_float conv_s32_u32 \
    conv_u32_bit conv_u32_float conv_u32_s32 \
    corexy_by_hal \
    dbounce ddt deadzone demux differential div2 edge feedcomp \
    flipflop gantry gray2bin hypot integ invert \
    knob2float limit1 limit2 lincurve logic lowpass lut5 \
    maj3 match8 minmax mult2 multiclick mux16 mux2 mux4 mux8 \
    near not offset or2 plasmac sample_hold scale scaled_s32_sums \
    select8 sim_axis_hardware sim_home_switch sim_parport sphereprobe \
    steptest sum2 threadtest tof toggle toggle2nist ton tp tristate_bit \
    tristate_float updown wcomp xor2

CMOD_COMPS := $(addprefix hal/components/, $(addsuffix .comp, $(CMOD_COMP_NAMES)))
CMOD_TARGETS := $(addprefix ../cmod/, $(addsuffix .so, $(CMOD_COMP_NAMES)))

# Everything else stays with halcompile (legacy RT API)
COMPS := $(filter-out $(CMOD_COMPS), \
    $(filter-out hal/components/tpcomp.comp, \
        $(sort $(wildcard hal/components/*.comp) \
               $(addprefix hal/components/, $(CONVERTERS)))))
COMP_MANPAGES := $(patsubst hal/components/%.comp, ../docs/man/man9/%.9, $(COMPS) $(CMOD_COMPS)) ../docs/man/man9/tpcomp.9
COMP_DRIVERS += hal/drivers/serport.comp
COMP_DRIVERS += hal/drivers/mesa_7i65.comp
COMP_DRIVERS += hal/drivers/mesa_uart.comp
COMP_DRIVER_MANPAGES := $(patsubst hal/drivers/%.comp, ../docs/man/man9/%.9, $(COMP_DRIVERS))
TARGETS += manpages
GENERATED_MANPAGES += $(COMP_MANPAGES)
GENERATED_MANPAGES += $(COMP_DRIVER_MANPAGES)
.PHONY: manpages
ifeq ($(TRIVIAL_BUILD),no)
-include $(patsubst %.comp, objects/%.mak, $(COMPS) $(COMP_DRIVERS))
Makefile: $(patsubst %.comp, objects/%.mak, $(COMPS) $(COMP_DRIVERS))
endif

RTMODULES += $(patsubst hal/drivers/%.comp, %.o, $(patsubst hal/components/%.comp, %.o, $(COMPS) $(COMP_DRIVERS)))

$(COMP_MANPAGES): ../docs/man/man9/%.9: hal/components/%.comp ../bin/halcompile
	$(ECHO) Making halcompile manpage $(notdir $@)
	@mkdir -p $(dir $@)
	$(Q)../bin/halcompile -U --document -o $@.new $< && preconv -r < $@.new > $@
	$(RM) $@.new

$(COMP_DRIVER_MANPAGES): ../docs/man/man9/%.9: hal/drivers/%.comp ../bin/halcompile
	$(ECHO) Making halcompile manpage $(notdir $@)
	@mkdir -p $(dir $@)
	$(Q)../bin/halcompile -U --document -o $@ $<

objects/%.mak: %.comp hal/components/Submakefile
	$(ECHO) "Creating $(notdir $@)"
	@mkdir -p $(dir $@)
	$(Q)echo $(notdir $*)-objs := objects/$*.o > $@.tmp
	$(Q)echo ../rtlib/$(notdir $*)$(MODULE_EXT): objects/rtobjects/$*.o >> $@.tmp
	$(Q)mv -f $@.tmp $@

objects/%.c: %.comp ../bin/halcompile
	$(ECHO) "Preprocessing $(notdir $<)"
	@mkdir -p $(dir $@)
	$(Q)../bin/halcompile -U -o $@ $<

modules: $(patsubst %.comp, objects/%.c, $(COMPS) $(COMP_DRIVERS))

# keep this make target in 2.6, remove in 2.7 (just use 'clean-manpages' in 2.7+)
clean-comp-manpages: clean-manpages

