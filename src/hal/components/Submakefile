# ---------------------------------------------------------------------------
# Legacy components that stay with halcompile (explicit list)
# These use features not supported by cmod or have special requirements
# ---------------------------------------------------------------------------
HALCOMPILE_COMP_NAMES := \
    homecomp             \
    mesa_pktgyro_test    \
    tpcomp
# Reasons:
#   homecomp, tpcomp      - use EXTRA_SETUP (motion controller integration)
#   mesa_pktgyro_test     - hostmot2 driver test (depends on internal headers)

# Kinematics .comp modules: built via modcompile with gmi_provide kins.
# Need the GMI kins API header path at compile time.
CMOD_KINS_COMP_NAMES := millturn userkins xyzab_tdr_kins

HALCOMPILE_COMPS := $(addprefix hal/components/, $(addsuffix .comp, $(HALCOMPILE_COMP_NAMES)))

# ---------------------------------------------------------------------------
# Components built via modcompile (cmod API, output to ../cmod/)
# All .comp files except those in HALCOMPILE_COMPS
# ---------------------------------------------------------------------------
CMOD_COMPS := $(filter-out $(HALCOMPILE_COMPS), $(sort $(wildcard hal/components/*.comp)))
CMOD_COMP_NAMES := $(patsubst hal/components/%.comp,%,$(CMOD_COMPS))
CMOD_TARGETS := $(addprefix ../cmod/, $(addsuffix .so, $(CMOD_COMP_NAMES)))

# Everything in HALCOMPILE_COMPS except tpcomp (which is special)
COMPS := $(filter-out hal/components/tpcomp.comp, $(HALCOMPILE_COMPS))

# Man pages: cmod components use modcompile, legacy use halcompile
CMOD_MANPAGES := $(patsubst hal/components/%.comp, ../docs/man/man9/%.9, $(CMOD_COMPS))
HALCOMPILE_MANPAGES := $(patsubst hal/components/%.comp, ../docs/man/man9/%.9, $(COMPS)) ../docs/man/man9/tpcomp.9
COMP_MANPAGES := $(CMOD_MANPAGES) $(HALCOMPILE_MANPAGES)
COMP_DRIVERS += hal/drivers/serport.comp
COMP_DRIVERS += hal/drivers/mesa_7i65.comp
COMP_DRIVERS += hal/drivers/mesa_uart.comp
COMP_DRIVER_MANPAGES := $(patsubst hal/drivers/%.comp, ../docs/man/man9/%.9, $(COMP_DRIVERS))
TARGETS += manpages
GENERATED_MANPAGES += $(COMP_MANPAGES)
GENERATED_MANPAGES += $(COMP_DRIVER_MANPAGES)
.PHONY: manpages
ifeq ($(TRIVIAL_BUILD),no)
-include $(patsubst %.comp, objects/%.mak, $(COMPS) $(COMP_DRIVERS))
Makefile: $(patsubst %.comp, objects/%.mak, $(COMPS) $(COMP_DRIVERS))
endif

RTMODULES += $(patsubst hal/drivers/%.comp, %.o, $(patsubst hal/components/%.comp, %.o, $(COMPS) $(COMP_DRIVERS)))

# Man pages for cmod components (use modcompile)
$(CMOD_MANPAGES): ../docs/man/man9/%.9: hal/components/%.comp ../bin/modcompile
	$(ECHO) Making modcompile manpage $(notdir $@)
	@mkdir -p $(dir $@)
	$(Q)../bin/modcompile --document -o $@.new $< && preconv -r < $@.new > $@
	$(RM) $@.new

# Man pages for legacy halcompile components
$(HALCOMPILE_MANPAGES): ../docs/man/man9/%.9: hal/components/%.comp ../bin/halcompile
	$(ECHO) Making halcompile manpage $(notdir $@)
	@mkdir -p $(dir $@)
	$(Q)../bin/halcompile -U --document -o $@.new $< && preconv -r < $@.new > $@
	$(RM) $@.new

$(COMP_DRIVER_MANPAGES): ../docs/man/man9/%.9: hal/drivers/%.comp ../bin/halcompile
	$(ECHO) Making halcompile manpage $(notdir $@)
	@mkdir -p $(dir $@)
	$(Q)../bin/halcompile -U --document -o $@ $<

objects/%.mak: %.comp hal/components/Submakefile
	$(ECHO) "Creating $(notdir $@)"
	@mkdir -p $(dir $@)
	$(Q)echo $(notdir $*)-objs := objects/$*.o > $@.tmp
	$(Q)echo ../rtlib/$(notdir $*)$(MODULE_EXT): objects/rtobjects/$*.o >> $@.tmp
	$(Q)mv -f $@.tmp $@

objects/%.c: %.comp ../bin/halcompile
	$(ECHO) "Preprocessing $(notdir $<)"
	@mkdir -p $(dir $@)
	$(Q)../bin/halcompile -U -o $@ $<

modules: $(patsubst %.comp, objects/%.c, $(COMPS) $(COMP_DRIVERS))

# keep this make target in 2.6, remove in 2.7 (just use 'clean-manpages' in 2.7+)
clean-comp-manpages: clean-manpages

