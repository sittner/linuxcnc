	$(ECHO) "Preprocessing cmod $(notdir $<)"
	@mkdir -p $(dir $@)
	$(Q)../bin/modcompile --preprocess $< > $@

# Userspace cmod .so — links with -lpthread for user_mainloop thread.
../cmod/usbpend.so: objects/cmod/usbpend.c
	$(ECHO) "Compiling cmod $(notdir $@)"
	@mkdir -p $(dir $@)
	$(Q)$(CC) -fPIC -Os -Wall -shared -I $(CMOD_INCLUDE) -o $@ $< -lm -lpthread

