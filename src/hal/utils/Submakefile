	$(Q)(echo '#!$(PYTHON)'; sed '1 { /^#!/d; }' $<) > $@.tmp && chmod +x $@.tmp && mv -f $@.tmp $@

TARGETS += ../bin/halcompile ../bin/elbpcom ../bin/mesa-modcompile ../share/linuxcnc/mesa_modbus.c.tmpl ../bin/mesambccc
objects/%.py: %.g
	@mkdir -p $(dir $@)
	$(Q)$(YAPPS) $< $@
