# Legacy halcmd/halrmt - disabled when BUILD_GOLANG=yes (replaced by Go REST halcmd)
ifneq ($(BUILD_GOLANG),yes)
HALCMDSRCS := hal/utils/halcmd.c hal/utils/halcmd_commands.cc hal/utils/halcmd_main.c
HALSHSRCS := hal/utils/halcmd.c hal/utils/halcmd_commands.cc hal/utils/halsh.c

ifneq ($(READLINE_LIBS),)
HALCMDSRCS += hal/utils/halcmd_completion.c
endif
USERSRCS += $(sort $(HALCMDSRCS) $(HALSHSRCS))

$(call TOOBJSDEPS, $(HALSHSRCS)) : EXTRAFLAGS = -fPIC
$(call TOOBJSDEPS, hal/utils/halsh.c) : EXTRAFLAGS += $(TCL_CFLAGS)
../tcl/hal.so: $(call TOOBJS, $(HALSHSRCS)) ../lib/liblinuxcncini.so.0 ../lib/liblinuxcnchal.so.0
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CXX) $(LDFLAGS) -shared $^  $(TCL_LIBS) -o $@
TARGETS += ../tcl/hal.so

../bin/halcmd: $(call TOOBJS, $(HALCMDSRCS)) ../lib/liblinuxcncini.so.0 ../lib/liblinuxcnchal.so.0 
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CXX) $(LDFLAGS) -o $@ $^ $(READLINE_LIBS)
TARGETS += ../bin/halcmd

HALRMTSRCS := hal/utils/halrmt.c
USERSRCS += $(HALRMTSRCS)

../bin/halrmt: $(call TOOBJS, $(HALRMTSRCS)) ../lib/liblinuxcnchal.so.0
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CC) $(LDFLAGS) -o $@ $^ -lpthread
TARGETS += ../bin/halrmt
endif # BUILD_GOLANG

ifneq ($(GTK_VERSION),)
HALMETERSRCS := \
    hal/utils/meter.c \
    hal/utils/miscgtk.c

USERSRCS += $(HALMETERSRCS)

../bin/halmeter: $(call TOOBJS, $(HALMETERSRCS)) ../lib/liblinuxcnchal.so.0
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CC) $(LDFLAGS) -o $@ $^  $(GTK_LIBS)
TARGETS += ../bin/halmeter

HALSCOPESRCS := \
    hal/utils/scope.c \
    hal/utils/scope_horiz.c \
    hal/utils/scope_vert.c \
    hal/utils/scope_trig.c \
    hal/utils/scope_disp.c \
    hal/utils/scope_files.c \
    hal/utils/miscgtk.c

USERSRCS += $(HALSCOPESRCS)

../bin/halscope: $(call TOOBJS, $(HALSCOPESRCS)) ../lib/liblinuxcnchal.so.0
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CC) $(LDFLAGS) -o $@ $^ $(GTK_LIBS) -lm
TARGETS += ../bin/halscope

HALGTKSRCS := \
    hal/utils/scope.c \
    hal/utils/scope_horiz.c \
    hal/utils/scope_vert.c \
    hal/utils/scope_trig.c \
    hal/utils/scope_disp.c \
    hal/utils/scope_files.c \
    hal/utils/meter.c \
    hal/utils/miscgtk.c
$(call TOOBJSDEPS, $(HALGTKSRCS)) : EXTRAFLAGS = $(GTK_CFLAGS)
$(call TOOBJS, $(HALGTKSRCS)): Makefile.inc
endif

# ---------------------------------------------------------------------------
# halscope_rt cmod (replaces legacy scope_rt.c for GMI architecture)
# ---------------------------------------------------------------------------
ifeq ($(BUILD_GOLANG),yes)

HALSCOPE_RT_CMOD_CFLAGS := \
    -fPIC -Os -Wall -Wextra \
    -DUSPACE -D_GNU_SOURCE -Drealtime \
    -fno-strict-aliasing -fwrapv \
    -I. -I../include -Igomc/pkg/cmodule -Igomc/generated/gmi/halscope

../cmod/halscope_rt.so: hal/utils/halscope_rt.c \
                        gomc/generated/gmi/halscope/halscope_api.h \
                        $(wildcard gomc/pkg/cmodule/gomc_*.h) \
                        | headers ../lib/liblinuxcnchal.so
	$(ECHO) "Compiling cmod halscope_rt.so"
	@mkdir -p $(dir $@)
	$(Q)$(CC) -shared $(HALSCOPE_RT_CMOD_CFLAGS) \
	    -o $@ hal/utils/halscope_rt.c \
	    -L../lib -llinuxcnchal -lm

TARGETS += ../cmod/halscope_rt.so
modules: ../cmod/halscope_rt.so

endif # BUILD_GOLANG

# ---------------------------------------------------------------------------
# Flutter toolchain (downloaded on demand, cached in tools/)
# ---------------------------------------------------------------------------
FLUTTER_VERSION := 3.24.0
FLUTTER_DIR := tools/flutter
FLUTTER := $(FLUTTER_DIR)/bin/flutter

$(FLUTTER):
	@mkdir -p tools
	$(ECHO) "Downloading Flutter SDK $(FLUTTER_VERSION)..."
	$(Q)curl -sL https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_$(FLUTTER_VERSION)-stable.tar.xz \
	    | tar xJ -C tools/
	$(Q)$(FLUTTER) --disable-analytics >/dev/null 2>&1 || true
	$(Q)$(FLUTTER) precache --linux >/dev/null 2>&1

# ---------------------------------------------------------------------------
# halscope Flutter UI
# ---------------------------------------------------------------------------
HALSCOPE_FLUTTER_DIR := hal/utils/halscope_flutter

.PHONY: halscope-flutter
halscope-flutter: $(FLUTTER)
	$(ECHO) "Building halscope Flutter app..."
	$(Q)cd $(HALSCOPE_FLUTTER_DIR) && $(abspath $(FLUTTER)) build linux --release
	$(Q)cp $(HALSCOPE_FLUTTER_DIR)/build/linux/x64/release/bundle/halscope_flutter ../bin/halscope-flutter


../bin/halcompile: ../bin/%: objects/hal/utils/%.py
	@$(ECHO) Syntax checking python script $(notdir $@)
	$(Q)$(PYTHON) -m py_compile $<
	$(ECHO) Copying python script $(notdir $@)
	$(Q)(echo '#!$(PYTHON)'; sed '1 { /^#!/d; }' $<) > $@.tmp && chmod +x $@.tmp && mv -f $@.tmp $@

../bin/elbpcom: ../bin/%: hal/utils/%.py
	@$(ECHO) Syntax checking python script $(notdir $@)
	$(Q)$(PYTHON) -m py_compile $<
	$(ECHO) Copying python script $(notdir $@)
	$(Q)(echo '#!$(PYTHON)'; sed '1 { /^#!/d; }' $<) > $@.tmp && chmod +x $@.tmp && mv -f $@.tmp $@

../bin/mesa-modcompile: ../bin/mesa-%: hal/drivers/mesa-hostmot2/modbus/%.py
